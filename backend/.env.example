# JWT Configuration (Required)
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database (Optional - defaults to users.json)
DATABASE_PATH=users.json

# Server (Optional - defaults to 0.0.0.0:8000)
HOST=0.0.0.0
PORT=8000

# ---- Evaluation harness (backend/eval) ----
# LangSmith (required to log datasets + experiment results)
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=antiburnout-eval
# LANGSMITH_TRACING=true

# Real-LLM eval (required for `python -m eval.run agent`)
# Either provider works — set whichever key you have:
# OPENROUTER_API_KEY=sk-or-v1-...
OPENAI_API_KEY=sk-...
EVAL_MODEL=                # optional; defaults to openai/gpt-4o-mini (OpenRouter) or gpt-4o-mini (OpenAI)
# LLM_BASE_URL=            # optional; defaults to the provider's official endpoint
